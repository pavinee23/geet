# Contact form (app/api/contact/route.js) — set in Vercel Project Settings
SMTP_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_EMAIL=GE Energy Tech <your-email@gmail.com>
CONTACT_TO_EMAIL=your-email@gmail.com

# Optional: main app URL for Admin / Register / Sign-in buttons
# NEXT_PUBLIC_PORTAL_BASE_URL=https://your-main-app.example.com
